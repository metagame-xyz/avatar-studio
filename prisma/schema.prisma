// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Account {
  id         String    @id @default(cuid())
  userId     String
  type       String // could be a privy enum 'email' | 'phone' | 'wallet'
  subject    String?
  email      String?
  username   String?
  name       String?
  address    String?
  number     String?
  chainType  String?
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [privyDID], onDelete: Cascade)
}

model User {
  id            String                   @id @default(cuid())
  privyDID      String                   @unique
  firstName     String?
  lastName      String?
  email         String?                  @unique
  image         String?
  address       String?                  @unique
  accounts      Account[]
  projects      MembersOfProjects[]
  achievements  MemberAchievements[]
  organizations MembersOfOrganizations[]
  invitations   OrganizationInvitation[]
  //   role          UserRole?
  role          String?
}

model OrganizationInvitation {
  // id             Int          @id @unique @default(autoincrement())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  // email          String
  inviteeAddress String
  // role           OrganizationRole @default(ADMIN)
  role           String
  // status         InvitationStatus @default(PENDING)
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  issuedBy       User         @relation(fields: [issuedById], references: [id])
  issuedById     String

  @@id([organizationId, inviteeAddress, role])
}

model Organization {
  id          Int                      @id @unique @default(autoincrement())
  name        String                   @unique
  slug        String                   @unique
  projects    Project[]
  admins      MembersOfOrganizations[]
  invitations OrganizationInvitation[]
}

model MembersOfOrganizations {
  member         User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  //   role           OrganizationRole @default(ADMIN)
  role           String       @default("ADMIN")

  @@id([organizationId, userId])
}

model Project {
  id                  Int                   @id @unique @default(autoincrement())
  name                String                @unique
  slug                String                @unique
  contractAddress     String?               @unique
  description         String?
  traitCategories     TraitCategory[]
  organization        Organization          @relation(fields: [organizationId], references: [id])
  members             MembersOfProjects[]
  organizationId      Int
  AchievementCategory AchievementCategory[]
}

model MembersOfProjects {
  member  User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  //   role      ProjectRole
  role    String

  userId    String
  projectId Int

  @@id([userId, projectId])
}

model TraitCategory {
  project         Project @relation(fields: [projectId], references: [id])
  traits          Trait[]
  name            String
  zIndex          Int
  modifiable      Boolean @default(true)
  defaultAchieved Boolean @default(false)

  projectId Int

  @@id([projectId, name])
}

model Trait {
  //   id                              Int                  @id @unique @default(autoincrement())
  traitCategory                   TraitCategory        @relation(fields: [projectId, traitCategoryName], references: [projectId, name], onDelete: Cascade)
  name                            String
  pngUrl                          String
  defaultAchieved                 Boolean?
  achievementsRequired            AchievementTrait[]
  achievementsRequiredDescription String?
  //   levelLogic                      LevelLogic?
  levelLogic                      String?
  LevelCategory                   AchievementCategory? @relation(fields: [achievementCategoryId], references: [id])
  levelRequired                   Int?

  projectId             Int
  traitCategoryName     String
  achievementCategoryId Int?

  @@id([projectId, traitCategoryName, name])
}

model AchievementCategory {
  id           Int           @id @unique @default(autoincrement())
  name         String
  description  String?
  project      Project       @relation(fields: [projectId], references: [id])
  achievements Achievement[]
  //   type         AchievementType @default(SPECIFIC_ACHIEVEMENT)
  type         String        @default("SPECIFIC_ACHIEVEMENT")
  Trait        Trait[]

  projectId Int
}

model Achievement {
  id                  Int                  @id @unique @default(autoincrement())
  achievementCategory AchievementCategory  @relation(fields: [achievementCategoryId], references: [id])
  name                String
  level               Int?
  members             MemberAchievements[]
  Trait               AchievementTrait[]

  achievementCategoryId Int
}

model AchievementTrait {
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  trait         Trait       @relation(fields: [projectId, traitCategoryName, traitName], references: [projectId, traitCategoryName, name])
  achievementId Int
  traitId       Int

  projectId         Int
  traitCategoryName String
  traitName         String

  @@id([achievementId, traitId])
}

model MemberAchievements {
  member      User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])
  timestamp   DateTime    @default(now())
  status      Boolean     @default(true)

  achievementId Int
  userId        String

  @@id([userId, achievementId])
}

