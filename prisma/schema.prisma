// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["orderByNulls", "extendedWhereUnique"]
}

datasource db {
  provider = "postgresql"
  // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Account {
  id         String    @id @default(cuid())
  userId     String
  type       String // could be a privy enum 'email' | 'phone' | 'wallet'
  subject    String?
  email      String?
  username   String?
  name       String?
  address    String?
  number     String?
  chainType  String?
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [privyDID], onDelete: Cascade)
}

model User {
  id                    String                     @id @default(cuid())
  privyDID              String                     @unique
  firstName             String?
  lastName              String?
  email                 String?                    @unique
  image                 String?
  address               String?                    @unique
  accounts              Account[]
  projects              MembersOfProjects[]
  achievements          MemberAchievements[]
  organizations         MembersOfOrganizations[]
  invitations           OrganizationInvitation[]
  role                  UserRole?
  nftMetadata           NftMetadata[]
  airtableAccessGranted OrganizationAirtableAuth[]
}

model OrganizationInvitation {
  // id             Int          @id @unique @default(autoincrement())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  // email          String
  inviteeAddress String
  // role           OrganizationRole @default(ADMIN)
  role           String
  // status         InvitationStatus @default(PENDING)
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  issuedBy       User         @relation(fields: [issuedById], references: [id])
  issuedById     String

  @@id([organizationId, inviteeAddress, role])
}

model Organization {
  id           Int                       @id @unique @default(autoincrement())
  name         String                    @unique
  slug         String                    @unique
  projects     Project[]
  admins       MembersOfOrganizations[]
  invitations  OrganizationInvitation[]
  airtableAuth OrganizationAirtableAuth?
}

model OrganizationAirtableAuth {
  id                     Int          @id @unique @default(autoincrement())
  scope                  String
  accessToken            String
  accessTokenExpiration  DateTime
  refreshToken           String
  refreshTokenExpiration DateTime
  organization           Organization @relation(fields: [organizationSlug], references: [slug])
  organizationSlug       String       @unique
  accessGrantedUser      User         @relation(fields: [accessGrantedUserId], references: [id])
  accessGrantedUserId    String
}

model Lock {
  id    String @id @unique
  owner String
}

model MembersOfOrganizations {
  member         User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  //   role           OrganizationRole @default(ADMIN)
  role           String       @default("ADMIN")

  @@id([organizationId, userId])
}

model Project {
  id                  Int                   @id @unique @default(autoincrement())
  name                String                @unique
  slug                String                @unique
  description         String?
  traitCategories     TraitCategory[]
  organization        Organization          @relation(fields: [organizationId], references: [id])
  members             MembersOfProjects[]
  organizationId      Int
  AchievementCategory AchievementCategory[]
  NftMetadata         NftMetadata[]

  contractAddress     String? @unique
  network             String? @default("ethereum")
  testContractAddress String? @unique
  testNetwork         String? @default("goerli")

  airtableProject AirtableProject?
}

model AirtableProject {
  id        Int     @id @unique @default(autoincrement())
  project   Project @relation(fields: [projectId], references: [id])
  projectId Int     @unique
  baseId    String
  baseName  String
  tableId   String
  tableName String
}

model MembersOfProjects {
  member  User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectSlug], references: [slug])
  //   role      ProjectRole
  role    String  @default("MEMBER")

  userId      String
  projectSlug String

  @@id([userId, projectSlug])
}

model TraitCategory {
  project           Project @relation(fields: [projectId], references: [id])
  traits            Trait[]
  name              String
  zIndex            Int
  isModifiable      Boolean @default(true)
  isDefaultAchieved Boolean @default(false)

  projectId Int

  @@id([projectId, name])
}

model Trait {
  id                              Int                  @id @unique @default(autoincrement())
  traitCategory                   TraitCategory        @relation(fields: [projectId, traitCategoryName], references: [projectId, name], onDelete: Cascade)
  name                            String
  pngUrl                          String
  isDefaultAchieved               Boolean?
  achievementsRequired            Achievement[]
  achievementsRequiredDescription String?
  //   levelLogic                      LevelLogic?
  levelLogic                      String?
  levelCategory                   AchievementCategory? @relation(fields: [achievementCategoryId], references: [id])
  levelRequired                   Int?

  projectId             Int
  traitCategoryName     String
  achievementCategoryId Int?

  nftMetadata NftMetadata[]

  @@unique([projectId, traitCategoryName, name])
}

model AchievementCategory {
  id           Int             @id @unique @default(autoincrement())
  airtableId   String?
  name         String
  description  String?
  project      Project         @relation(fields: [projectId], references: [id])
  achievements Achievement[]
  type         AchievementType @default(SPECIFIC_ACHIEVEMENT)
  traits       Trait[]

  projectId Int

  @@unique([projectId, airtableId])
}

model Achievement {
  id                  Int                  @id @unique @default(autoincrement())
  achievementCategory AchievementCategory  @relation(fields: [achievementCategoryId], references: [id])
  name                String
  level               Int?
  members             MemberAchievements[]
  traits              Trait[]

  achievementCategoryId Int
}

model MemberAchievements {
  member      User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])
  timestamp   DateTime    @default(now())
  status      Boolean     @default(true)

  achievementId Int
  userId        String

  @@id([userId, achievementId])
}

model NftMetadata {
  id            Int      @id @unique @default(autoincrement())
  member        User     @relation(fields: [userId], references: [id])
  project       Project  @relation(fields: [projectSlug], references: [slug])
  name          String
  image         String?
  description   String
  externalUrl   String?
  tokenId       Int?
  timestamp     DateTime @default(now())
  walletAddress String
  traits        Trait[]
  traitHash     String

  network String @default("goerli")

  userId      String
  projectSlug String

  @@unique([traitHash, network, timestamp])
  @@unique([tokenId, projectSlug, network, timestamp])
  @@unique([walletAddress, projectSlug, network, timestamp])
  @@unique([userId, projectSlug, network, timestamp])
}

// enum ProjectRole {
//   OWNER
//   ADMIN
//   MEMBER
// }

// enum LevelLogic {
//   MORE_THAN_OR_EQUAL_TO
//   LESS_THAN_OR_EQUAL_TO
// }

enum AchievementType {
  SPECIFIC_ACHIEVEMENT
  LEVEL
}

// enum OrganizationRole {
//   ADMIN
//   OWNER
// }

enum UserRole {
  METAGAME_ADMIN
  METAGAME_OWNER
}
