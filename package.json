{
    "name": "avatar-studio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "next build",
        "dev": "next dev",
        "postinstall": "prisma generate",
        "format": "prettier --write \"**/*.ts\" \"**/*.tsx\" \"**/*.cjs\" && prisma format",
        "type-check": "tsc",
        "lint": "next lint",
        "start": "next start",
        "check": "yarn run type-check && yarn run lint && yarn run format"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    },
