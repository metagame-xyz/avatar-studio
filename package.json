        "@tanstack/react-query": "^4.16.0",
        "@trpc/client": "^10.0.0",
        "@trpc/next": "^10.0.0",
        "@trpc/react-query": "^10.0.0",
        "@trpc/server": "^10.0.0",
        "ethereum-blockies-base64": "^1.0.2",
        "ethers": "^5.7.2",
        "next": "13.0.2",
        "next-auth": "^4.18.3",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "siwe": "^2.1.3",
        "slugify": "^1.6.5",
