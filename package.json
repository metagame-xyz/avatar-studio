{
    "name": "avatar-studio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "next build",
        "dev": "next dev",
        "postinstall": "prisma generate",
        "format": "prettier --write \"**/*.ts\" \"**/*.tsx\" \"**/*.cjs\" && prisma format",
        "type-check": "tsc",
        "lint": "next lint",
        "start": "next start",
        "check": "yarn run type-check && yarn run lint && yarn run format",
        "refresh-dev-db": "cross-env DATABASE_URL=$(cat .env | grep DEV_DB_URL | cut -d '=' -f2) prisma migrate reset"
    },
    "prisma": {
        "seed": "ts-node -r tsconfig-paths/register --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    },
    "dependencies": {
        "@headlessui/react": "^1.7.7",
        "@heroicons/react": "^2.0.13",
        "@prisma/client": "^4.10.1",
        "@privy-io/react-auth": "1.12.0-beta.2",
        "@privy-io/server-auth": "^1.1.2",
        "@privy-io/wagmi-connector": "0.0.1-beta.6",
        "@radix-ui/react-toast": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.0.2",
        "@stitches/react": "^1.2.8",
        "@tailwindcss/forms": "^0.5.3",
        "@tanstack/react-query": "^4.16.0",
        "@trpc/client": "^10.0.0",
        "@trpc/next": "^10.0.0",
        "@trpc/react-query": "^10.0.0",
        "@trpc/server": "^10.0.0",
        "airtable": "^0.11.6",
        "aws-sdk": "^2.1294.0",
        "base64url": "^3.0.1",
        "ethereum-blockies-base64": "^1.0.2",
        "ethers": "^5.7.2",
        "framer-motion": "^8.4.3",
        "lodash.isequal": "^4.5.0",
        "merge-images": "^2.0.0",
        "next": "13.0.2",
        "qs": "^6.11.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-use": "^17.4.0",
        "siwe": "^2.1.3",
        "slugify": "^1.6.5",
        "superjson": "1.9.1",
        "ts-case-convert": "^2.0.2",
        "wagmi": "^0.10.10",
        "zod": "^3.18.0"
    },
    "devDependencies": {
        "@types/airtable": "^0.10.1",
        "@types/lodash.isequal": "^4.5.6",
        "@types/merge-images": "^1.2.1",
        "@types/node": "^18.0.0",
        "@types/qs": "^6.9.7",
        "@types/react": "^18.0.14",
        "@types/react-dom": "^18.0.5",
        "@typescript-eslint/eslint-plugin": "^5.33.0",
        "@typescript-eslint/parser": "^5.33.0",
        "autoprefixer": "^10.4.7",
        "cross-env": "^7.0.3",
        "dotenv": "^16.0.3",
        "eslint": "^8.26.0",
        "eslint-config-next": "13.0.2",
        "postcss": "^8.4.14",
        "prettier": "^2.7.1",
        "prettier-plugin-organize-imports": "^3.2.1",
        "prettier-plugin-tailwindcss": "^0.2.1",
        "prisma": "^4.10.1",
        "tailwindcss": "^3.2.4",
        "typescript": "^4.8.4"
    },
    "ct3aMetadata": {
        "initVersion": "6.11.4"
    }
}
